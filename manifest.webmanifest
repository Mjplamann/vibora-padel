{
  "id": "./",
  "name": "Víbora Padel",
  "short_name": "Víbora",
  "description": "First-person, camera-tracked padel training on your Mac and TV: your arms and racket, real glass, real spin. Works offline.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#03060b",
  "theme_color": "#05090f",
  "categories": ["sports", "games", "health"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Play with mouse", "short_name": "Mouse", "url": "./?source=app&fallback=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Rally with Coach", "short_name": "Rally", "url": "./?source=app&mode=rally", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Swipe mode", "short_name": "Swipe", "url": "./?source=app&input=swipe", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
